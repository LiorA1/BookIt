# Docker setup (docker compose). Copy this file to .env.docker and fill in real values. Do NOT commit .env.docker.
# The local setup uses .env (template: .env.example) instead.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Debug mode. Keep False in production. Accepts: 1/true/yes/on
# seed_data only runs with DEBUG=True.
DEBUG=True

# Comma-separated list of allowed hosts, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection used by the API container. docker-compose.yml always sets DB_HOST=db and DB_PORT=5432.
DB_NAME=bookit
DB_USER=postgres
DB_PASSWORD=bookit
DB_HOST=db
DB_PORT=5432

# PostgreSQL container settings. Keep them equal to DB_NAME, DB_USER, and DB_PASSWORD above. They only apply when
# the database volume is first created; after changing them, recreate it with `docker compose down -v`.
POSTGRES_DB=bookit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bookit

# Optional booking horizon in days (default 365).
# BOOKING_MAX_ADVANCE_DAYS=365

# Optional shared password for users created by `python manage.py seed_data`.
# SEED_PASSWORD=BookIt-Demo-2026!
