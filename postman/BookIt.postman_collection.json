          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service\": {{serviceId}},\n  \"start_time\": \"2027-03-01T10:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] }
          }
        },
        {
          "name": "Book an appointment (no token -> 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service\": {{serviceId}},\n  \"start_time\": \"2027-03-01T10:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] }
          }
        },
        {
          "name": "Book an appointment (past start -> 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 on start_time', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json()).to.have.property('start_time');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service\": {{serviceId}},\n  \"start_time\": \"2020-01-01T10:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] }
          }
        },
        {
          "name": "Book an appointment (unknown service -> 400)",
          "event": [
