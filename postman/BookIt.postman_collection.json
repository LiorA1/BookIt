        {
          "name": "Book an appointment (same slot twice -> 409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fixed far-future slot: the first run books it (201), every later run conflicts (409).",
                  "pm.variables.set('conflictStart', new Date(Date.now() + 340 * 24 * 60 * 60 * 1000).toISOString().slice(0, 11) + '03:00:00Z');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 on the first booking or 409 once the slot is taken', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 409) pm.expect(pm.response.json()).to.have.property('start_time');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service\": {{serviceId}},\n  \"start_time\": \"{{conflictStart}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] },
            "description": "Send it twice: an active appointment of the same service cannot overlap (enforced by a PostgreSQL exclusion constraint). The slot is computed per day, so it only conflicts with itself within one day."
          }
        }
      ]
