          "name": "List appointments - no token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] }
          }
        },
        {
          "name": "Book an appointment (client)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A random half-hour slot 60-300 days ahead: after the seeded window, inside the 365-day horizon,",
                  "// and unlikely to repeat, so the request can be re-run (an overlap returns 409).",
                  "const start = new Date(Date.now() + (60 + Math.floor(Math.random() * 240)) * 24 * 60 * 60 * 1000);",
                  "start.setUTCHours(Math.floor(Math.random() * 24), Math.random() < 0.5 ? 0 : 30, 0, 0);",
                  "pm.variables.set('startTime', start.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created as pending', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('pending');",
                  "  pm.expect(body.client.full_name).to.eql('Maya Friedman');",
                  "  pm.expect(body.service.id).to.eql(Number(pm.collectionVariables.get('serviceId')));",
                  "  pm.expect(new Date(body.end_time) > new Date(body.start_time)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service\": {{serviceId}},\n  \"start_time\": \"{{startTime}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] },
            "description": "Run \"List my appointments (client)\" first so `serviceId` is set. `start_time` needs a UTC offset, must be in the future and at most 365 days ahead. `end_time` is `start_time` plus the service duration."
          }
        },
        {
          "name": "Book an appointment (owner -> 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden for a business owner', () => pm.response.to.have.status(403));"]
