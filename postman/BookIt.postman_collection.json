{
  "info": {
    "name": "BookIt API",
    "description": "Requests for the BookIt API (auth, businesses, appointments), using the logins created by `python manage.py seed_data`.\n\nRun the folders in order (Auth, Businesses, Appointments): the login requests save `clientToken` and `ownerToken`, and the appointment list saves a real `serviceId` for the booking requests. Database ids differ on every seed run, so none are hard-coded.\n\nRoutes need the trailing slash (a slashless POST fails). Not covered yet: business summary endpoint and refresh endpoint (not implemented).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "seedPassword", "value": "BookIt-Demo-2026!" },
    { "key": "clientEmail", "value": "client1@bookit.test" },
    { "key": "ownerEmail", "value": "owner1@bookit.test" },
    { "key": "clientToken", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "businessId", "value": "" },
    { "key": "otherBusinessId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (new client)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A unique email per run, so the request can be sent repeatedly.",
                  "pm.variables.set('newUserEmail', `postman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns the user without a password', () => {",
                  "  pm.expect(body).to.have.keys('id', 'email', 'full_name', 'role');",
                  "  pm.expect(body.role).to.eql('Client');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"S3cure-pass-2026!\",\n  \"full_name\": \"Postman Client\",\n  \"role\": \"Client\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""] },
            "description": "Public. Valid roles are `Client` and `BusinessOwner`."
          }
        },
        {
          "name": "Register (duplicate email -> 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with a field-oriented email error', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json()).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"S3cure-pass-2026!\",\n  \"full_name\": \"Duplicate Client\",\n  \"role\": \"Client\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""] },
            "description": "The seeded client email is already registered; uniqueness is case-insensitive."
          }
        },
        {
          "name": "Login (seeded client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns access and refresh tokens', () => pm.expect(body).to.have.keys('access', 'refresh'));",
                  "const claims = JSON.parse(atob(body.access.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.test('access token carries user_id and role', () => {",
                  "  pm.expect(claims).to.have.property('user_id');",
                  "  pm.expect(claims.role).to.eql('Client');",
                  "});",
                  "pm.collectionVariables.set('clientToken', body.access);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{seedPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] },
            "description": "Seeded client `client1@bookit.test`. Saves the access token as `clientToken`."
          }
        },
        {
          "name": "Login (seeded business owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const claims = JSON.parse(atob(body.access.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.test('access token carries the BusinessOwner role', () => pm.expect(claims.role).to.eql('BusinessOwner'));",
                  "pm.collectionVariables.set('ownerToken', body.access);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{seedPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] },
            "description": "Seeded owner `owner1@bookit.test` (owns Sharp Fade and Clean Cut Studio). Saves the access token as `ownerToken`."
          }
        },
        {
          "name": "Login (wrong password -> 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with a Bearer challenge', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"not-the-password\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] }
          }
        }
      ]
    },
    {
      "name": "Businesses",
      "item": [
        {
          "name": "List businesses (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paginated envelope with the total count', () => {",
                  "  pm.expect(body).to.have.keys('count', 'next', 'previous', 'results');",
                  "  pm.expect(body.count).to.eql(20);",
                  "  pm.expect(body.results).to.have.lengthOf(5);",
                  "});",
                  "pm.test('item schema', () => pm.expect(body.results[0]).to.have.keys('id', 'name', 'category', 'owner'));",
                  "// The seed lists each owner's businesses together, so the first page of 5 spans two owners.",
                  "pm.collectionVariables.set('businessId', body.results[0].id);",
                  "const other = body.results.find(b => b.owner.id !== body.results[0].owner.id);",
                  "pm.collectionVariables.set('otherBusinessId', other.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/?page=1&page_size=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", ""],
              "query": [{ "key": "page", "value": "1" }, { "key": "page_size", "value": "5" }]
            },
            "description": "The seed creates 20 businesses, so `count` is 20 whatever the page size. `page_size` defaults to 20 and is capped at 100."
          }
        },
        {
          "name": "List businesses - category=barbers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('10 barber businesses in total', () => {",
                  "  pm.expect(body.count).to.eql(10);",
                  "  body.results.forEach(b => pm.expect(b.category).to.eql('barbers'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/?category=barbers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", ""],
              "query": [{ "key": "category", "value": "barbers" }]
            },
            "description": "`category` is `barbers` or `tutors`, lowercase only."
          }
        },
        {
          "name": "List businesses - search=fade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('finds Sharp Fade (case-insensitive name search)', () => {",
                  "  pm.expect(body.count).to.be.at.least(1);",
                  "  pm.expect(body.results.map(b => b.name)).to.include('Sharp Fade');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/?search=fade",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", ""],
              "query": [{ "key": "search", "value": "fade" }]
            }
          }
        },
        {
          "name": "List businesses - category + search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('count reflects both filters', () => {",
                  "  pm.expect(body.count).to.eql(1);",
                  "  pm.expect(body.results[0].name).to.eql('Math Masters');",
                  "  pm.expect(body.results[0].category).to.eql('tutors');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/?category=tutors&search=math",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", ""],
              "query": [{ "key": "category", "value": "tutors" }, { "key": "search", "value": "math" }]
            }
          }
        },
        {
          "name": "List businesses - invalid category -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 on the category field', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json()).to.have.property('category');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/?category=plumbers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", ""],
              "query": [{ "key": "category", "value": "plumbers" }]
            }
          }
        },
        {
          "name": "List businesses - no token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/businesses/", "host": ["{{baseUrl}}"], "path": ["api", "businesses", ""] }
          }
        },
        {
          "name": "Business summary (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paginated envelope with one item per service', () => {",
                  "  pm.expect(body).to.have.keys('count', 'next', 'previous', 'results');",
                  "  pm.expect(body.count).to.be.above(0);",
                  "  body.results.forEach(item => pm.expect(item).to.have.keys('service_id', 'name', 'appointment_count', 'expected_revenue'));",
                  "});",
                  "pm.test('revenue is a decimal string, zero when there are no future appointments', () => {",
                  "  body.results.forEach(item => {",
                  "    pm.expect(item.expected_revenue).to.match(/^\\d+\\.\\d{2}$/);",
                  "    if (item.appointment_count === 0) pm.expect(item.expected_revenue).to.eql('0.00');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/summary/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}", "summary", ""]
            },
            "description": "Owner-only. One item per service: the number of future, non-cancelled appointments and the expected revenue (count x price, as a decimal string). Run `List businesses (paginated)` first; `businessId` is the first seeded business, owned by owner1."
          }
        },
        {
          "name": "Business summary (another owner's business -> 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('no summary data is returned', () => pm.expect(pm.response.json()).to.not.have.property('results'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{otherBusinessId}}/summary/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{otherBusinessId}}", "summary", ""]
            },
            "description": "owner1 asks for a business owned by a different owner."
          }
        },
        {
          "name": "Business summary (client -> 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/summary/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}", "summary", ""]
            }
          }
        },
        {
          "name": "Business summary (unknown business -> 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/999999999/summary/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "999999999", "summary", ""]
            }
          }
        },
        {
          "name": "Business summary - no token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/summary/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}", "summary", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "List my appointments (client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paginated envelope', () => pm.expect(body).to.have.keys('count', 'next', 'previous', 'results'));",
                  "pm.test('seeded client has appointments with display fields', () => {",
                  "  pm.expect(body.count).to.be.above(0);",
                  "  const item = body.results[0];",
                  "  pm.expect(item).to.have.keys('id', 'status', 'start_time', 'end_time', 'service', 'business', 'client');",
                  "  pm.expect(item.service).to.have.property('name');",
                  "  pm.expect(item.business).to.have.property('name');",
                  "  pm.expect(item.client.full_name).to.eql('Maya Friedman');",
                  "});",
                  "// Real service id for the booking requests (database ids change on every seed run).",
                  "pm.collectionVariables.set('serviceId', body.results[0].service.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] },
            "description": "A client only sees their own appointments. Saves the first appointment's service id as `serviceId`."
          }
        },
        {
          "name": "List appointments of my businesses (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('only appointments of businesses owned by owner1', () => {",
                  "  pm.expect(body.count).to.be.above(0);",
                  "  const owned = ['Sharp Fade', 'Clean Cut Studio', 'Math Masters', 'Bagrut Boost'];",
                  "  body.results.forEach(a => pm.expect(owned).to.include(a.business.name));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] },
            "description": "A business owner sees appointments for services of the businesses they own (owner1 owns Sharp Fade, Clean Cut Studio, Math Masters and Bagrut Boost)."
          }
        },
        {
          "name": "List appointments - from / to / status",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The seed spreads appointments over the 30 days around the run date.",
                  "const day = 24 * 60 * 60 * 1000;",
                  "pm.variables.set('from', new Date(Date.now() - 30 * day).toISOString());",
                  "pm.variables.set('to', new Date(Date.now() + 30 * day).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('every item is inside the range and has an allowed status', () => {",
                  "  const from = new Date(pm.variables.get('from')), to = new Date(pm.variables.get('to'));",
                  "  body.results.forEach(a => {",
                  "    pm.expect(new Date(a.start_time)).to.be.within(from, to);",
                  "    pm.expect(['confirmed', 'pending']).to.include(a.status);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/?from={{from}}&to={{to}}&status=confirmed&status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", ""],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "status", "value": "confirmed" },
                { "key": "status", "value": "pending" }
              ]
            },
            "description": "`from` / `to` are inclusive bounds on `start_time` and must be ISO 8601 with a timezone (`Z` or an offset; encode `+` as `%2B`). `status` is `pending`, `confirmed` or `cancelled`; repeat it to match several."
          }
        },
        {
          "name": "List appointments - naive from -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 on the from field', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json()).to.have.property('from');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/?from=2026-11-10T10:00:00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", ""],
