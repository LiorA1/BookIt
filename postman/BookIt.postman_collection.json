            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service\": 999999999,\n  \"start_time\": \"2027-03-01T10:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/appointments/", "host": ["{{baseUrl}}"], "path": ["api", "appointments", ""] }
          }
