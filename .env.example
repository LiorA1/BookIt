# Copy this file to .env and fill in real values. Do NOT commit .env.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Debug mode. Keep False in production. Accepts: 1/true/yes/on
DEBUG=True

# Comma-separated list of allowed hosts, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
